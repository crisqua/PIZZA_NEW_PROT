# URL da API (Sprint 7). Default no codigo (data/api.ts) e' http://localhost:3000 --
# so' precisa deste arquivo se a API rodar em outro lugar.
VITE_API_URL=http://localhost:3000

# Slug do tenant (Sprint 7). Em producao o slug vem do subdominio real (MVP.md item 5,
# ainda sem hosting), mas o Vite dev server roda em localhost sem subdominio -- esta
# variavel e' o fallback pra dev local. Use o slug de um tenant ja seedado no homolog.
VITE_TENANT_SLUG=
