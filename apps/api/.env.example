# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# --- Supabase (homologacao) ---
# Pooler de transacao (Supavisor, porta 6543) — usado em runtime pela aplicacao, com a
# role restrita "pizza_app" (rode scripts/setup-app-role.ts uma vez antes, usando
# DIRECT_URL). "?pgbouncer=true" e obrigatorio (Prisma + Supavisor em modo transaction).
DATABASE_URL="postgresql://pizza_app.<project-ref>:<app-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Pooler de sessao (porta 5432), role "postgres" — usado por `prisma migrate` (DDL nao e
# confiavel via pooler de transacao) e por scripts/setup-app-role.ts (precisa de conexao
# com privilegio pra CREATE ROLE/GRANT).
DIRECT_URL="postgresql://postgres.<project-ref>:<postgres-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

PORT=3000

# Role restrita usada pelos testes de isolamento e, em runtime, pela propria aplicacao
# (nunca a role "postgres" — e superuser e sempre ignora RLS/FORCE RLS). Ver scripts/setup-app-role.ts.
APP_DB_ROLE=pizza_app
APP_DB_PASSWORD=troque-por-uma-senha-forte

# --- Auth (Sprint 2) ---
# Segredos de assinatura JWT — DEVEM ser diferentes um do outro (um access token nunca pode
# ser reutilizado como refresh token, mesmo se a checagem de "type" no payload falhar por
# algum bug futuro). Gere com algo como `openssl rand -hex 48`.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-48-bytes
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-diferente-do-anterior
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Nome do cookie httpOnly que carrega o refresh token.
REFRESH_COOKIE_NAME=pizza_refresh

# Origem(ns) permitida(s) para CORS, separadas por virgula. 5173 = apps/cliente,
# 5174 = apps/pizzaria (Sprint 9), 5175 = apps/admin-pizzarias (Sprint 10).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Controla o atributo "secure" do cookie de refresh (so via HTTPS em producao).
NODE_ENV=development

# --- Cache (Sprint 3, opcional) ---
# Se ausente, CacheModule usa fallback in-memory automaticamente (MemoryCacheService) —
# nenhuma infra externa e obrigatoria pra rodar a aplicacao localmente. Setar apenas se
# quiser exercitar o caminho real do Redis (ex.: redis://localhost:6379, ou uma instancia
# gerenciada tipo Upstash em homolog/producao).
REDIS_URL=
