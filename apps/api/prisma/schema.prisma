generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Sem RLS de proposito (Sprint 1, arquitetura secao 3.1/6.3): o painel Admin-Pizzarias
// precisa enxergar todos os tenants ao mesmo tempo; isolamento aqui e por rota/RBAC, nao
// RLS. scripts/check-rls.sql ja exclui "tenants" explicitamente por nome.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(60)
  active    Boolean  @default(true)
  // Uma cor de acento so' (nao primaria+secundaria) — bate com o design system aprovado
  // (docs/DESIGN_JORNADA_CLIENTE.md: "accent e' por tenant... campo primary_color") e
  // com o formulario real (TenantForm.tsx so' tem um seletor de cor).
  primaryColor String @default("#C9A84C") @map("primary_color") @db.VarChar(7)
  // Emoji curto, nao URL/upload — TenantForm.tsx trata logo como Input maxLength={2}
  // rotulado "Logo (Emoji)". VarChar(8) conta code points (nao bytes), cobre com folga
  // qualquer emoji de 1-2 code points (bandeiras/sequencias ZWJ inclusive).
  logo         String @default("🍕") @db.VarChar(8)
  phone        String @default("") @db.VarChar(20)
  address      String @default("") @db.VarChar(255)
  // Primeiras colunas monetarias do schema — Decimal(10,2), nao Int centavos nem Float,
  // estabelece o padrao pra products.price (Sprint 5) e totais de pedido depois. Cuidado:
  // Prisma.Decimal serializa via .toJSON() como STRING ("8.00"), nao number — todo
  // response precisa mapear .toNumber() explicitamente antes de devolver ao cliente.
  deliveryFee Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  minOrder    Decimal @default(0) @map("min_order") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  subscription Subscription?

  @@map("tenants")
}

// role: 'platform_superadmin' | 'tenant_owner' | 'tenant_staff' | 'customer'
// (validado em código, não em CHECK de banco — mesmo padrão do Barberaria).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  email        String   @db.VarChar(160)
  name         String   @db.VarChar(120)
  role         String   @db.VarChar(20)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  // Perfil de entrega do cliente (Sprint 7) — preenchido de verdade so' pra role:'customer',
  // vazio pros demais papeis. Decisao tomada com o usuario nesta sprint: estender User em
  // vez de criar uma tabela Customer separada (o esboco ER da arquitetura sugere separar
  // PII numa tabela propria, mas User.@@unique([tenantId,id]) ja' foi deixado pronto pra
  // esse reuso, e o cliente ja' e' User{role:'customer'} desde a Sprint 2 com self-service
  // funcionando em /v1/users/me — nao vale criar modulo novo so' pra 5 campos de texto).
  phone         String   @default("") @db.VarChar(20)
  address       String   @default("") @db.VarChar(255)
  addressNumber String   @default("") @map("address_number") @db.VarChar(20)
  complement    String   @default("") @db.VarChar(120)
  neighborhood  String   @default("") @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  orders        Order[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, role], map: "idx_users_tenant")
  @@map("users")
}

// Rotacao de refresh token (Sprint 2, ver docs/MVP_SPRINTS.md): tokenHash e sempre SHA-256
// do token bruto — nunca Argon2 aqui, o token ja e alta entropia, hash rapido e o correto
// (Argon2 e deliberadamente lento, faria todo /auth/refresh pagar o custo de hash de senha).
// familyId agrupa a cadeia de rotacao inteira; reuso de um token ja revogado (revokedAt
// setado) e tratado como roubo — revoga a familia inteira, nao so o token reutilizado.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([tenantId, userId], map: "idx_refresh_tokens_tenant_user")
  @@map("refresh_tokens")
}

// Catalogo global de planos (Sprint 4) — sem tenant_id, RLS-exempt por omissao (dado da
// plataforma, nao de um tenant especifico, mesmo racional de "tenants" na secao 3.1/6.3
// da arquitetura). "code" e' imutavel apos criado — so' enforced no DTO (UpdatePlanDto
// nao declara o campo, o whitelist global rejeita 400 se vier), sem CHECK de banco,
// mesmo padrao ja usado pra "role" em User e "active" em Tenant.
model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(20)
  name       String   @db.VarChar(255)
  // Decimal(10,2) em reais (nao centavos) — mesma convencao monetaria da Sprint 3
  // (Tenant.deliveryFee/minOrder), nao a convencao em centavos do Barberaria. null =
  // "negociado" (plano Enterprise). Mesmo cuidado de serializacao: Prisma.Decimal vira
  // string via .toJSON(), todo response mapeia .toNumber() explicitamente.
  price      Decimal? @db.Decimal(10, 2)
  limitLabel String?  @map("limit_label") @db.VarChar(255)
  // Array de codigos de modulo opcional incluso ('estoque'|'financeiro') — validado so'
  // no DTO (@IsIn contra a lista fechada), Postgres so' guarda o JSON sem constraint.
  modules    Json     @default("[]")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

// Assinatura de um tenant a um plano (Sprint 4) — tenant-owned de verdade, RLS ligada e
// forcada (diferente de "plans"/"tenants": isso aqui e' dado por tenant, nao da
// plataforma). tenantId nunca e' nulo (nao existe assinatura de plataforma) — isso
// simplifica a policy RLS em relacao a de "users" (sem o branch OR de tenant_id IS NULL).
// Sem FK composta contra tenants/plans: essas tabelas nao tem tenant_id nenhum pra
// compor contra (a FK composta do refresh_tokens existe pra garantir consistencia entre
// duas tabelas RLS-protegidas que compartilham tenant_id — nao se aplica aqui).
model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  status    String   @default("active") @db.VarChar(20)
  startedAt DateTime @default(now()) @map("started_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// Categoria de cardapio (Sprint 5) — tenant-owned de verdade, RLS ligada e forcada. Cada
// pizzaria cadastra as proprias categorias (ja validado no protototipo, MenuManagement.tsx/
// ProductForm.tsx). Sem "slug": nada nesta API busca categoria por slug (diferente de
// Tenant.slug, usado numa rota publica) — selecao e' sempre por id (uuid) num dropdown.
// Sem "@relation" pra Tenant: tenant sempre vem do JWT/request.tenantId, nada atravessa
// category.tenant via Prisma (mesmo padrao de RefreshToken.tenantId).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(120)
  // 'pizza' | 'drink' | 'sobremesa' -- mesma convencao de Product.type (validado em
  // codigo, nao em CHECK de banco). Categoria pertence a um tipo so' (pedido do usuario:
  // cada categoria tem seu item, uma nao pode aparecer misturada na lista de outra) -- o
  // formulario de produto filtra as opcoes do <select> por este campo.
  type      String   @default("pizza") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  // Da' a chave composta pra "products" referenciar (mesmo papel de User.@@unique acima
  // pro RefreshToken) — segunda aplicacao real do padrao de FK composta do Sprint 2.
  @@unique([tenantId, id])
  @@index([tenantId], map: "idx_categories_tenant")
  @@map("categories")
}

// Produto de cardapio (Sprint 5) — tenant-owned de verdade, RLS ligada e forcada.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(160)
  description String   @default("") @db.VarChar(1000)
  // Terceira coluna monetaria do schema (estende Tenant.deliveryFee/minOrder e
  // Plan.price) — Decimal(10,2) em reais, nunca centavos/Float. Mesmo cuidado de sempre:
  // Prisma.Decimal vira string via .toJSON(), response mapeia .toNumber() explicitamente
  // (ver product-response.util.ts).
  // Usado por bebida e sobremesa (type!='pizza') -- preco unico, sem tamanho. Nullable
  // pelo mesmo motivo dos 3 campos abaixo: pizza nao usa este campo, so' os de tamanho.
  // Obrigatorio por tipo validado no DTO (@ValidateIf), nao a nivel de banco.
  price       Decimal? @db.Decimal(10, 2)
  // Pizza (type='pizza') usa preco explicito por tamanho em vez de preco-base x
  // multiplicador (decisao revertida nesta sprint: o dono digita o preco real de cada
  // tamanho, o que ele digita e' exatamente o que o cliente paga, sem conta escondida).
  // Nullable porque bebida nao usa -- obrigatorio pra pizza, validado no DTO
  // (@ValidateIf), nao a nivel de banco (nao da pra CHECK condicional simples por tipo
  // sem trigger, e o app ja garante isso na escrita).
  priceBrotinho    Decimal? @map("price_brotinho") @db.Decimal(10, 2)
  priceOitoPedacos Decimal? @map("price_oito_pedacos") @db.Decimal(10, 2)
  priceDozePedacos Decimal? @map("price_doze_pedacos") @db.Decimal(10, 2)
  // Variante em texto livre pra bebida/sobremesa (type!='pizza'), ex. "2L"/"Fatia" --
  // pizza ignora este campo (fica vazio). Nao e' preco nem tamanho de pizza (que tem os
  // 3 campos acima); e' so' um rotulo descritivo digitado pelo dono no cadastro.
  size        String   @default("") @db.VarChar(60)
  // URL simples, nao upload real — decisao confirmada com o usuario nesta sprint:
  // Supabase Storage/URL assinada fica pra depois (nao existe infra nenhuma ainda), e o
  // protototipo (ProductForm.tsx) ja so aceita colar uma URL num input de texto. Default
  // vazio (nao nullable) — diferente de Plan.price, aqui "vazio" nao carrega significado
  // de negocio, mesmo padrao de Tenant.logo/phone.
  image       String   @default("") @db.VarChar(2048)
  // Lista de ingredientes em texto livre — mesma convencao JSON-array-of-strings de
  // Plan.modules, mas sem lista fechada no DTO (aqui e' texto livre, nao um enum de 2
  // valores).
  ingredients Json     @default("[]")
  featured    Boolean  @default(false)
  // "Disponibilidade" do DoD desta sprint — sem precedente real no protototipo (so' um
  // <Badge> fixo "Ativo" em MenuManagement.tsx, nao ligado a nenhum campo). true =
  // disponivel, mesmo default-true de Plan.active/Tenant.active.
  available   Boolean  @default(true)
  // 'pizza' | 'drink' | 'sobremesa' — validado em codigo, mesma convencao de role/status.
  // Existe pra order_items saber se o preco e' media dos precos-por-tamanho dos sabores
  // (pizza) ou direto (bebida/sobremesa), sem depender de casamento fragil por nome de
  // categoria.
  type        String   @default("pizza") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relacao Prisma normal (coluna unica), igual RefreshToken.user -> User. A FK COMPOSTA
  // (tenant_id, category_id) contra categories(tenant_id, id) e' uma constraint EXTRA,
  // hand-written só na migration (Prisma DSL nao expressa FK composta parcial contra
  // unique nao-PK) — mesmo padrao exato de refresh_tokens/users (Sprint 2), garantindo
  // que categoryId nunca aponte pra uma categoria de outro tenant, mesmo por bug.
  category Category @relation(fields: [categoryId], references: [id])
  orderItemsAsFirst  OrderItem[] @relation("OrderItemProduct")
  orderItemsAsSecond OrderItem[] @relation("OrderItemSecondProduct")

  // Preparado pra ser referenciado por order_items na Sprint 7, mesmo raciocinio de
  // User.@@unique antes do RefreshToken existir.
  @@unique([tenantId, id])
  @@index([tenantId, categoryId], map: "idx_products_tenant_category")
  @@map("products")
}

// Item de estoque (Sprint 6) — tenant-owned, RLS ligada e forcada, forma estrita (mesma
// de Category/Product/Subscription). Sem FK composta: nao referencia nenhuma outra
// tabela tenant-scoped. "quantity"/"minQuantity" usam Decimal(10,2) mesmo nao sendo
// dinheiro -- quarta aplicacao dessa convencao (depois de Tenant.deliveryFee/minOrder,
// Plan.price, Product.price), mesma necessidade de precisao de 2 casas sem drift de
// Float. Mesmo cuidado de sempre: Decimal.toJSON() vira string, response mapeia
// .toNumber() (ver inventory-item-response.util.ts). Status ("Critico"/"Baixo"/"OK") e'
// calculado no frontend a partir de quantity/minQuantity (Inventory.tsx), nunca
// persistido aqui.
model InventoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(160)
  unit        String   @db.VarChar(20)
  quantity    Decimal  @db.Decimal(10, 2)
  minQuantity Decimal  @map("min_quantity") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("inventory_items")
}

// Pedido (Sprint 7) — tenant-owned de verdade, RLS ligada e forcada, forma estrita (mesma
// de Category/Product/Subscription). "status": 'pending'|'preparing'|'delivery'|
// 'completed'|'cancelled', maquina de transicoes validada em codigo (src/orders/
// order-status.ts), nunca aceita valor arbitrario do cliente. Campos de entrega/pagamento
// sao SNAPSHOT do momento da compra (customerName/phone/address/...), nunca relidos do
// perfil do User depois — endereco pode mudar no /v1/users/me sem afetar pedidos ja
// feitos. "total"/deliveryFee sao sempre calculados no servidor (OrdersService), nunca
// confiados do client. idempotencyKey + @@unique([tenantId,idempotencyKey]) e' o
// mecanismo de idempotencia na criacao (arquitetura secao 3.2 item 7): duas requisicoes
// concorrentes com a mesma chave batem na mesma constraint, so' uma cria a linha.
model Order {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  status         String   @default("pending") @db.VarChar(20)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  customerName   String   @map("customer_name") @db.VarChar(120)
  phone          String   @db.VarChar(20)
  address        String   @db.VarChar(255)
  addressNumber  String   @default("") @map("address_number") @db.VarChar(20)
  complement     String   @default("") @db.VarChar(120)
  neighborhood   String   @default("") @db.VarChar(120)
  paymentMethod  String   @map("payment_method") @db.VarChar(20)
  changeFor      Decimal? @map("change_for") @db.Decimal(10, 2)
  deliveryFee    Decimal  @map("delivery_fee") @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relacao Prisma normal (coluna unica) + FK COMPOSTA hand-written na migration
  // (tenant_id, customer_id) -> users(tenant_id, id) — mesmo padrao exato de
  // Product.category (Sprint 5), garante que customerId nunca aponte pra um usuario de
  // outro tenant, mesmo por bug.
  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, customerId], map: "idx_orders_tenant_customer")
  @@index([tenantId, status], map: "idx_orders_tenant_status")
  @@map("orders")
}

// Item de pedido (Sprint 7) — tenant-owned, RLS ligada e forcada. Primeiro caso do schema
// com TRES pernas de FK composta hand-written na migration (tenant_id,order_id)->orders,
// (tenant_id,product_id)->products, (tenant_id,second_product_id)->products — a ultima
// nullable (meio a meio), MATCH SIMPLE (default do Postgres) satisfaz a constraint
// automaticamente quando second_product_id IS NULL, mesmo raciocinio ja documentado em
// refresh_tokens/fk_refresh_token_tenant_matches_user. secondProductId e' o segundo sabor
// (pizza meio a meio); size (PizzaSizeId) e' null pra bebida. "name"/"unitPrice" sao
// SNAPSHOT calculados no servidor no momento da criacao (OrdersService) — nunca confiados
// do client, e sobrevivem a um produto renomeado/apagado depois.
model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  secondProductId String?  @map("second_product_id") @db.Uuid
  type            String   @db.VarChar(20)
  size            String?  @db.VarChar(20)
  name            String   @db.VarChar(200)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  order         Order   @relation(fields: [orderId], references: [id])
  product       Product @relation("OrderItemProduct", fields: [productId], references: [id])
  // onDelete explicito (Restrict, igual product/order acima) -- sem isso o default do
  // Prisma pra relacao opcional e' SetNull, divergindo da migration hand-written
  // original que sempre foi RESTRICT (mesmo raciocinio: nao apagar um produto que ainda
  // e' referenciado por um pedido, nem o segundo sabor do meio a meio).
  secondProduct Product? @relation("OrderItemSecondProduct", fields: [secondProductId], references: [id], onDelete: Restrict)

  @@index([tenantId, orderId], map: "idx_order_items_tenant_order")
  @@map("order_items")
}

// Despesa (Sprint 8, add-on Financeiro) — tenant-owned, RLS ligada e forcada, forma
// estrita (mesma de Category/Product/Subscription/InventoryItem). "category" e' uma
// lista fechada de 3 valores ('Insumos'|'Fixas'|'Outras', igual o prototipo
// Financial.tsx), validada so' no DTO via @IsIn, mesmo padrao de Product.type/
// Plan.modules -- sem CHECK no banco. "amount" e' Decimal(10,2) em reais (nao centavos --
// correcao do texto original do MVP_SPRINTS.md, mesma categoria da correcao de Plan.price
// na Sprint 4), quinta aplicacao dessa convencao monetaria do schema. "date" e' so' a
// data do lancamento (@db.Date, sem hora), diferente de createdAt/updatedAt. Sem
// "@relation" pra Tenant, sem FK composta -- nao referencia nenhuma outra tabela
// tenant-scoped, mesmo raciocinio de InventoryItem.
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  description String   @db.VarChar(255)
  category    String   @db.VarChar(20)
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, date], map: "idx_expenses_tenant_date")
  @@map("expenses")
}
